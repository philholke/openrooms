# OpenRooms Backend — Environment Variables
# Copy to .env and fill in production values.

# Async connection string (used by the FastAPI app at runtime)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/openrooms

# Sync connection string (used by Alembic for migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/openrooms

# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production

# "development" or "production"
ENVIRONMENT=development

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=["http://localhost:3000"]
